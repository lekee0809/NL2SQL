DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/analytics
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
LLM_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=5000
MAX_RESULT_ROWS=200
CATALOG_RETRIEVAL_ENABLED=false
CATALOG_RETRIEVAL_TOP_K=10
SESSION_TTL_SECONDS=3600
SESSION_MAX_SAVED=1000
SESSION_STORAGE=sqlite
# 可选：SESSION_STORE_PATH=D:/your-private-directory/nl2sql-sessions.sqlite3
DEFAULT_SOURCE_ID=analytics_local
